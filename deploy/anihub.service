# AniHub systemd 服务单元（由 deploy/setup.sh 安装，占位符会被替换）
# 安装位置: /etc/systemd/system/anihub.service
[Unit]
Description=AniHub (Anime Calendar / Blog / Wiki)
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# 与 npm start 一致的启动命令（server/.env 由部署脚本生成）
ExecStart=/usr/bin/node --env-file-if-exists=server/.env --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# 说明：本服务不做 NoNewPrivileges / ProtectSystem / ProtectHome 等安全加固——
# 管理员需要在网页控制台里 su/sudo 提权、跑 deploy/update.sh 更新网站、访问 /home。
# 提权入口：setup.sh 已给 __APP_USER__ 配免密 sudo（/etc/sudoers.d/anihub）。

[Install]
WantedBy=multi-user.target
